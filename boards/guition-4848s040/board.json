{
  "id": "guition-4848s040",
  "name": "Guition ESP32-4848S040 (4\" 480x480)",
  "vendor": "Guition",
  "group": "All-in-one boards",
  "description": "4\" 480x480 square ST7701 panel with GT911 touch, sold as the \"86 box\" wall-plate unit.",
