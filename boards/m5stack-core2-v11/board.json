{
  "id": "m5stack-core2-v11",
  "name": "M5Stack Core2 v1.1 (AXP2101)",
  "vendor": "M5Stack",
  "group": "All-in-one boards",
  "description": "2.0\" 320x240 ILI9342C with FT6336U touch. The Core2 v1.1: its panel's supply, reset and backlight are the AXP2101's.",
  "mcu": {
    "id": "esp32",
    "name": "ESP32 (WROOM / WROVER)"
  },
  "flashMB": 16,
  "psramMB": 8,
  "usbCdc": false,
  "display": {
    "controller": "ili9342",
    "controllerName": "ILI9342 / ILI9342C",
    "interface": "spi",
    "width": 320,
    "height": 240,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 18,
      "mosi": 23,
      "miso": 38,
      "cs": 5,
      "dc": 15,
      "rst": {
        "pmu": "per_core2v11_pmic",
        "rail": "aldo2"
      }
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "VSPI",
      "spiMode": "0",
      "threeWire": false
    },
    "backlight": {
      "pin": -1,
      "active": 1,
      "pwm": false,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "ft6236",
    "controllerName": "FT6236 / FT6336U",
    "pins": {
      "sda": 21,
      "scl": 22,
      "int": 39,
      "rst": -1
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x38",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "Internal I2C (GPIO 21 / 22)",
      "kind": "i2c",
      "pins": {
        "sda": 21,
        "scl": 22
      }
    },
    {
      "name": "Port A (Grove, GPIO 32 / 33)",
      "kind": "i2c",
      "pins": {
        "sda": 32,
        "scl": 33
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "Power",
      "chip": "AXP2101",
      "kind": "Power",
      "bus": "Internal I2C (GPIO 21 / 22)",
      "address": "0x34"
    }
  ],
  "digitalIO": [],
  "analogInputs": [],
  "audio": null,
  "verify": "This is the Core2 v1.1, with an AXP2101 power chip; the first Core2 (v1.0) has an AXP192 - choose the other preset for that one (the chip's id says which: 0x4A at register 0x03 is an AXP2101, 0x03 an AXP192). The panel's supply, reset and backlight are driven through the AXP2101 as LovyanGFX's Core2 start-up drives them; the backlight is on at 3.0 V and does not dim. MicroPython starts the chip before the panel too, on the touch panel I2C bus; ESPHome has no component for it and is not offered. Compiled; not seen on a panel by LCD Wizard.",
  "links": {
    "page": "https://lcdwizard.com/boards/m5stack-core2-v11",
    "designer": "https://app.lcdwizard.com/app?board=m5stack-core2-v11"
  }
}
