{
  "id": "waveshare-s3-touch-lcd-28",
  "name": "Waveshare ESP32-S3-Touch-LCD-2.8",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "2.8\" 240x320 IPS LCD (ST7789T3, SPI), CST328 touch, PCM5101A speaker, TF card, QMI8658C, PCF85063ATL, battery sense.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 16,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "st7789",
    "controllerName": "ST7789",
    "interface": "spi",
    "width": 240,
    "height": 320,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": true,
    "pins": {
      "sck": 40,
      "mosi": 45,
      "miso": 46,
      "cs": 42,
      "dc": 41,
      "rst": 39
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI3_HOST"
    },
    "backlight": {
      "pin": 5,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "cst328",
    "controllerName": "CST328",
    "pins": {
      "sda": 1,
      "scl": 3,
      "int": 4,
      "rst": 2
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x1A",
      "freqKhz": 400,
      "sharedI2C": false
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 11 / 10)",
      "kind": "i2c",
      "pins": {
        "sda": 11,
        "scl": 10
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "IMU",
      "chip": "QMI8658",
      "kind": "Motion",
      "bus": "I2C (GPIO 11 / 10)",
      "address": "0x6B"
    },
    {
      "name": "RTC",
      "chip": "PCF85063",
      "kind": "Time",
      "bus": "I2C (GPIO 11 / 10)",
      "address": "0x51"
    },
    {
      "name": "SDCard",
      "chip": "SD card",
      "kind": "Storage",
      "pins": {
        "clk": 14,
        "cmd": 17,
        "d0": 16
      }
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    },
    {
      "name": "PWRKeyBATButton",
      "direction": "in",
      "pin": 6,
      "activeLow": true
    }
  ],
  "analogInputs": [
    {
      "name": "Battery",
      "pin": 8,
      "unit": "V"
    }
  ],
  "audio": {
    "output": "i2s_ext",
    "pins": {
      "bclk": 48,
      "lrclk": 38,
      "din": 47
    }
  },
  "verify": "Pins from Waveshare's demo code and schematic (https://files.waveshare.com/wiki/ESP32-S3-Touch-LCD-2.8/ESP32-S3-Touch-LCD-2.8-Demo.zip). Colour order: Arduino writes MADCTL 0x00 (RGB); ESP-IDF builds the panel with LCD_RGB_ENDIAN_BGR and mirror(true,false). The touch panel has I2C pins 1/3 to itself; the IMU and the clock are on 11/10. Its TF card (SDMMC, 1-bit, on 14/17/16 as Waveshare's demo has it), its speaker (the PCM5101A on I2S 48/38/47, arriving switched off: Hardware > Audio), and its battery input (GPIO 8, read x3) were added 2026-10-22 from the record, the preset having been made before the importer carried them; compiled, not run on a board. This is the V1 revision (CST328 touch at 0x1A), which Waveshare says was discontinued, boards shipped from 5 June 2026 being V2 (CST3530 at 0x58, same pins and panel) - check the label on the back; an Arduino export from either record reads whichever touch chip answers.",
