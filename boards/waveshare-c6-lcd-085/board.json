{
  "id": "waveshare-c6-lcd-085",
  "name": "Waveshare ESP32-C6-LCD-0.85",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "0.85\" 128x128 IPS LCD (ST7735, SPI), ES8311 audio, TF card.",
  "mcu": {
    "id": "esp32c6",
    "name": "ESP32-C6"
  },
  "flashMB": 8,
  "psramMB": 0,
  "usbCdc": true,
  "display": {
    "controller": "st7735",
    "controllerName": "ST7735",
    "interface": "spi",
    "width": 128,
    "height": 128,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 1,
      "mosi": 2,
      "miso": -1,
      "cs": 5,
      "dc": 3,
      "rst": 4
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 6,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": null,
  "buses": [
    {
      "name": "I2C (GPIO 8 / 7)",
      "kind": "i2c",
      "pins": {
        "sda": 8,
        "scl": 7
      }
    }
  ],
  "ioExpanders": [],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 9,
      "activeLow": true
    },
    {
      "name": "KEYPLUSButton",
      "direction": "in",
      "pin": 18,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 19,
      "bclk": 20,
      "lrclk": 22,
      "din": 23,
      "pa": 15
    }
  },
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-C6-LCD-0.85). bsp_display.h defines EXAMPLE_PIN_MOSI=1 / SCLK=2 (swapped), but those macros are unused - the bus is initialised from bsp_spi.h (SCLK=1, MOSI=2), and the schematic table (GPIO1=LCD_CLK, GPIO2=LCD_DIN), the Arduino demos and xiaozhi all agree on SCK=1/MOSI=2.",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-c6-lcd-085",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-c6-lcd-085",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-c6-lcd-0.85.htm",
    "vendorDocs": "http://docs.waveshare.com/ESP32-C6-LCD-0.85",
    "schematic": "https://github.com/waveshareteam/ESP32-C6-LCD-0.85/blob/main/hardware/schematics/ESP32-C6-LCD-0.85-Schematics.pdf"
  }
}
