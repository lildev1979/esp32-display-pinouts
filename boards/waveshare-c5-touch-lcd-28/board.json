{
  "id": "waveshare-c5-touch-lcd-28",
  "name": "Waveshare ESP32-C5-Touch-LCD-2.8",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "2.8\" 240x320 IPS LCD (ST7789 (docs link the ST7789V2 datasheet), SPI), CST3530 touch, ES8311 audio, TF card, QMI8658, PCF85063A.",
  "mcu": {
    "id": "esp32c5",
    "name": "ESP32-C5"
  },
  "flashMB": 32,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "st7789",
    "controllerName": "ST7789",
    "interface": "spi",
    "width": 240,
    "height": 320,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": true,
    "pins": {
      "sck": 6,
      "mosi": 7,
      "miso": 8,
      "cs": 10,
      "dc": 9,
      "rst": {
        "ext": "ext_waveshare_c5_touch_lcd_28_ws_ioext",
        "pin": 1
      }
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": {
        "ext": "ext_waveshare_c5_touch_lcd_28_ws_ioext",
        "pin": 8
      },
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "cst3530",
    "controllerName": "CST3530",
    "pins": {
      "sda": 0,
      "scl": 1,
      "int": 5,
      "rst": {
        "ext": "ext_waveshare_c5_touch_lcd_28_ws_ioext",
        "pin": 0
      }
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x58",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 0 / 1)",
      "kind": "i2c",
      "pins": {
        "sda": 0,
        "scl": 1
      }
    }
  ],
  "ioExpanders": [
    {
      "name": "IOExtension",
      "type": "ws_ioext",
      "address": "0x24"
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 28,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": null,
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-C5-Touch-LCD-2.8). Flash size: the schematic's module is ESP32-C5-WROOM-1-N32R8 and the docs say 32 MB; the ESP-IDF sdkconfig.defaults set CONFIG_ESPTOOLPY_FLASHSIZE_16MB.",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-c5-touch-lcd-28",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-c5-touch-lcd-28",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-c5-touch-lcd-2.8.htm",
    "vendorDocs": "http://docs.waveshare.com/ESP32-C5-Touch-LCD-2.8",
    "schematic": "https://github.com/waveshareteam/ESP32-C5-Touch-LCD-2.8/raw/refs/heads/main/schematic/ESP32-C5-Touch-LCD-2.8.pdf"
  }
}
