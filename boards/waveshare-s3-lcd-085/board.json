    "page": "https://lcdwizard.com/boards/waveshare-s3-lcd-085",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-s3-lcd-085",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-s3-lcd-0.85.htm",
    "vendorDocs": "http://docs.waveshare.com/ESP32-S3-LCD-0.85",
    "schematic": "https://files.waveshare.com/wiki/ESP32-S3-LCD-0.85/ESP32-S3-LCD-0.85-Schematic.pdf"
  }
