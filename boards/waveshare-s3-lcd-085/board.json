{
  "id": "waveshare-s3-lcd-085",
  "name": "Waveshare ESP32-S3-LCD-0.85",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "0.85\" 128x128 IPS LCD (GC9107, SPI), ES8311 audio, TF card.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 8,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "gc9107",
    "controllerName": "GC9107",
    "interface": "spi",
    "width": 128,
    "height": 128,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 38,
      "mosi": 39,
      "miso": -1,
      "cs": 21,
      "dc": 45,
      "rst": 40
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 46,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": null,
  "buses": [
    {
      "name": "I2C (GPIO 42 / 41)",
      "kind": "i2c",
      "pins": {
        "sda": 42,
        "scl": 41
      }
    }
  ],
  "ioExpanders": [],
  "digitalIO": [
    {
      "name": "BOOTKEYMINUSButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    },
    {
      "name": "PLUSButton",
      "direction": "in",
      "pin": 4,
      "activeLow": true
    },
    {
      "name": "PWRButton",
      "direction": "in",
      "pin": 5,
      "activeLow": false
    }
  ],
  "analogInputs": [],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 8,
      "bclk": 9,
      "lrclk": 10,
      "din": 12,
      "pa": 7
    }
  },
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-S3-LCD-0.85). The docs call it a 'capacitive LCD' and xiaozhi defines TOOUCH_INT 48 / TOOUCH_RST 47, but the schematic's LCD FPC has 12 pins and no touch lines, GPIO48 is the WS2812 data line and no demo reads touch - recorded touch null.",
