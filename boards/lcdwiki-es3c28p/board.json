{
  "id": "lcdwiki-es3c28p",
  "name": "LCDWIKI 2.8\" ESP32-S3 (ES3C28P)",
  "vendor": "LCDWIKI",
  "group": "All-in-one boards",
  "description": "2.8\" 240x320 IPS ILI9341V over SPI with FT6336G capacitive touch, an ES8311 codec with microphone and speaker output, a WS2812 LED, a 4-bit SD slot and battery charging.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 16,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "ili9341",
    "controllerName": "ILI9341",
    "interface": "spi",
    "width": 240,
    "height": 320,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 12,
      "mosi": 11,
      "miso": 13,
      "cs": 10,
      "dc": 46,
      "rst": -1
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "SPI2_HOST",
      "spiMode": "0",
      "threeWire": false,
      "tune": "ili9341v_ips"
    },
    "backlight": {
      "pin": 45,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "ft6236",
    "controllerName": "FT6236 / FT6336U",
    "pins": {
      "sda": 16,
      "scl": 15,
      "int": 17,
      "rst": 18
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x38",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 16 / 15, IIC header)",
      "kind": "i2c",
      "pins": {
        "sda": 16,
        "scl": 15
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "SDCard",
      "chip": "SD card",
      "kind": "Storage",
      "pins": {
        "clk": 38,
        "cmd": 40,
        "d0": 39,
        "d1": 41,
        "d2": 48,
        "d3": 47
      }
    },
    {
      "name": "RgbLed",
      "chip": "NeoPixel string",
      "kind": "Output",
      "pins": {
        "data": 42
      }
    }
  ],
  "digitalIO": [
    {
      "name": "BootButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    }
  ],
  "analogInputs": [
    {
      "name": "Battery",
      "pin": 9,
      "unit": "V"
    }
  ],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 4,
      "bclk": 5,
      "lrclk": 7,
      "din": 8,
      "pa": 1
    }
  },
  "verify": "Not yet run on a board: every pin here was read off LCDWIKI's page and schematic for the ES3C28P on 2026-10-12. The panel is set as LCDWIKI's own start-up code has it - inversion on, BGR. If colours come out negative turn Invert off; if red and blue are swapped, change the colour order. The panel's reset is the board's RESET button, not a GPIO. Touch (0x38), the ES8311 (0x18) and the IIC header share I2C on GPIO 16/15. Left free on the expansion header: GPIO 2, 3, 14 and 21, and UART0 on 43/44. The ES3N28P is the same board without touch: set Touch to None.",
  "links": {
    "page": "https://lcdwizard.com/boards/lcdwiki-es3c28p",
    "designer": "https://app.lcdwizard.com/app?board=lcdwiki-es3c28p",
    "vendorDocs": "https://www.lcdwiki.com/2.8inch_ESP32-S3_Display",
    "schematic": "https://www.lcdwiki.com/res/ES3C28P/2.8inch_ESP32-S3_Display_Schematic.pdf"
  }
}
