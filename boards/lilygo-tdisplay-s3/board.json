    "vendorDocs": "https://github.com/Xinyuan-LilyGO/T-Display-S3",
    "schematic": "https://raw.githubusercontent.com/Xinyuan-LilyGO/T-Display-S3/main/schematic/T_Display_S3.pdf"
  }
