{
  "id": "waveshare-s3-35b",
  "name": "Waveshare ESP32-S3-Touch-LCD-3.5B",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "3.5\" 320x480 AXS15231B over QSPI with touch in the same chip, an ES8311 codec with a microphone and speaker output, IMU, RTC, battery charging and a TF card.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 16,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "axs15231b",
    "controllerName": "AXS15231B",
    "interface": "qspi",
    "width": 320,
    "height": 480,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": false,
    "pins": {
      "cs": 12,
      "sck": 5,
      "d0": 1,
      "d1": 2,
      "d2": 3,
      "d3": 4,
      "rst": {
        "ext": "ext_ws35b_tca9554",
        "pin": 1
      }
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "SPI2_HOST",
      "initSeq": "lw_axs15231b_ws35b_init_operations"
    },
    "backlight": {
      "pin": 6,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "axs15231b_t",
    "controllerName": "AXS15231B (touch half)",
    "pins": {
      "sda": 8,
      "scl": 7,
      "int": -1,
      "rst": -1
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x3B",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 8 / 7, header pins 27 / 25)",
      "kind": "i2c",
      "pins": {
        "sda": 8,
        "scl": 7
      }
    }
  ],
  "ioExpanders": [
    {
      "name": "TCA9554",
      "type": "tca9554",
      "address": "0x20"
    }
  ],
  "digitalIO": [
    {
      "name": "BootButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 44,
      "bclk": 13,
      "lrclk": 15,
      "din": 16,
      "pa": {
        "ext": "ext_ws35b_tca9554",
        "pin": 7
      }
    }
  },
  "verify": "Panel reset (EXIO1), the speaker amplifier (EXIO7) and the TF card's DAT3 (EXIO3) are on the TCA9554 at 0x20; touch, the ES8311, the AXP2101, the QMI8658 and the PCF85063 share the I2C bus on GPIO 8/7. The panel ignores the row address over QSPI, so the export draws whole frames from a canvas in PSRAM. MCLK is GPIO44, which is also the header's RXD - leave it alone while audio is on. USB-C goes straight to the S3, so the serial log needs USB CDC On Boot (the export sets it). The microphone and the camera connector are wired but not driven.",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-s3-35b",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-s3-35b",
    "vendorProduct": "https://www.waveshare.com/esp32-s3-touch-lcd-3.5b.htm",
    "vendorDocs": "https://www.waveshare.com/wiki/ESP32-S3-Touch-LCD-3.5B",
    "schematic": "https://files.waveshare.com/wiki/ESP32-S3-Touch-LCD-3.5B/ESP32-S3-Touch-LCD-3.5B-Schematic.pdf"
  }
}
