      "pins": {
        "sda": 8,
        "scl": 9
      }
    }
  ],
  "ioExpanders": [
    {
      "name": "CH422G",
      "type": "ch422g",
      "address": "0x24"
    }
  ],
  "digitalIO": [],
  "analogInputs": [],
  "audio": null,
  "verify": "Touch reset (EXIO1), backlight enable (EXIO2) and panel reset (EXIO3) sit on a CH422G expander on the I2C bus at GPIO 8/9; the generated code brings the expander up first and drives them. EXIO4 is the SD card CS and EXIO5 selects USB - both left at their defaults.",
