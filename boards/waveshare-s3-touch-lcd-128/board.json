{
  "id": "waveshare-s3-touch-lcd-128",
  "name": "Waveshare ESP32-S3-Touch-LCD-1.28",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "1.28\" 240x240 IPS LCD (GC9A01A, SPI), CST816S touch, QMI8658.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 16,
  "psramMB": 2,
  "usbCdc": false,
  "display": {
    "controller": "gc9a01",
    "controllerName": "GC9A01 / GC9A01A",
    "interface": "spi",
    "width": 240,
    "height": 240,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 10,
      "mosi": 11,
      "miso": 12,
      "cs": 9,
      "dc": 8,
      "rst": 14
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 2,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "cst816s",
    "controllerName": "CST816S",
    "pins": {
      "sda": 6,
      "scl": 7,
      "int": 5,
      "rst": 13
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x15",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [],
  "ioExpanders": [],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": null,
  "verify": "Pins from Waveshare's demo code and schematic (https://files.waveshare.com/wiki/ESP32-S3-Touch-LCD-1.28/ESP32-S3-Touch-LCD-1.28-Demo.zip). Docs say two MOSFETs near the battery holder connect to GPIO4 and GPIO5, but the schematic shows GPIO4 = IMU_INT1 and GPIO5 = TP_INT, with Q3/Q4 marked NC (unpopulated).",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-s3-touch-lcd-128",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-s3-touch-lcd-128",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-s3-touch-lcd-1.28.htm",
    "vendorDocs": "http://docs.waveshare.com/ESP32-S3-Touch-LCD-1.28",
    "schematic": "https://files.waveshare.com/wiki/ESP32-S3-Touch-LCD-1.28/ESP32-S3-Touch-LCD-1.28_Rev3.pdf"
  }
}
