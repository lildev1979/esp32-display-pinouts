{
  "id": "waveshare-c3-lcd-147",
  "name": "Waveshare ESP32-C3-LCD-1.47",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "1.47\" 180x320 IPS LCD (ST7789T (driven by Waveshare's 'Vernon_ST7789T' esp_lcd component; docs spec table says 'ST7798', a typo), SPI), TF card, QMI8658.",
  "mcu": {
    "id": "esp32c3",
    "name": "ESP32-C3"
  },
  "flashMB": 4,
  "psramMB": 0,
  "usbCdc": true,
  "display": {
    "controller": "st7789",
    "controllerName": "ST7789",
    "interface": "spi",
    "width": 180,
    "height": 320,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 7,
      "mosi": 5,
      "miso": 6,
      "cs": -1,
      "dc": 8,
      "rst": {
        "ext": "ext_waveshare_c3_lcd_147_ws_ioext",
        "pin": 1
      }
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": {
        "ext": "ext_waveshare_c3_lcd_147_ws_ioext",
        "pin": 8
      },
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": null,
  "buses": [
    {
      "name": "I2C (GPIO 4 / 3)",
      "kind": "i2c",
      "pins": {
        "sda": 4,
        "scl": 3
      }
    }
  ],
  "ioExpanders": [
    {
      "name": "IOExtension",
      "type": "ws_ioext",
      "address": "0x24"
    }
  ],
  "peripherals": [
    {
      "name": "IMU",
      "chip": "QMI8658",
      "kind": "Motion",
      "bus": "I2C (GPIO 4 / 3)",
      "address": "0x6B"
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 9,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": null,
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-C3-LCD-1.47 (commit 6e16df57c20b3b1651c1b6150a1c5b3c418a87f6)). Resolution: docs and README say 172x320, but both demos (Arduino and ESP-IDF) address 180 columns with a 30-column gap.",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-c3-lcd-147",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-c3-lcd-147",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-c3-lcd-1.47.htm",
    "vendorDocs": "https://docs.waveshare.com/ESP32-C3-LCD-1.47",
    "schematic": "https://github.com/waveshareteam/ESP32-C3-LCD-1.47/blob/main/schematic/ESP32-C3-LCD-1.47.pdf"
  }
}
