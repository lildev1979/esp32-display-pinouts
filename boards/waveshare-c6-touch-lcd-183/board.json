{
  "id": "waveshare-c6-touch-lcd-183",
  "name": "Waveshare ESP32-C6-Touch-LCD-1.83",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "1.83\" 240x284 IPS LCD (ST7789P, SPI), CST816D touch, ES8311 audio, TF card, QMI8658, PCF85063, AXP2101.",
  "mcu": {
    "id": "esp32c6",
    "name": "ESP32-C6"
  },
  "flashMB": 16,
  "psramMB": 0,
  "usbCdc": true,
  "display": {
    "controller": "st7789",
    "controllerName": "ST7789",
    "interface": "spi",
    "width": 240,
    "height": 284,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": true,
    "pins": {
      "sck": 1,
      "mosi": 2,
      "miso": -1,
      "cs": 5,
      "dc": 3,
      "rst": 4
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 6,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "cst816s",
    "controllerName": "CST816S",
    "pins": {
      "sda": 7,
      "scl": 8,
      "int": 11,
      "rst": -1
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x15",
      "freqKhz": 400,
      "sharedI2C": true,
      "irq": "periodic"
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 7 / 8)",
      "kind": "i2c",
      "pins": {
        "sda": 7,
        "scl": 8
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "IMU",
      "chip": "QMI8658",
      "kind": "Motion",
      "bus": "I2C (GPIO 7 / 8)",
      "address": "0x6B"
    },
    {
      "name": "RTC",
      "chip": "PCF85063",
      "kind": "Time",
      "bus": "I2C (GPIO 7 / 8)",
      "address": "0x51"
    },
    {
      "name": "PMICbatterychargerailsPWRkey",
      "chip": "AXP2101",
      "kind": "Power",
      "bus": "I2C (GPIO 7 / 8)",
      "address": "0x34"
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 9,
      "activeLow": true
    },
    {
      "name": "PWRButton",
      "direction": "in",
      "pin": 18,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 19,
      "bclk": 20,
      "lrclk": 22,
      "din": 23,
      "pa": 0
    }
  },
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-C6-Touch-LCD-1.83 (commit deaf773feb2dd18a2a55b8156240547184f54d11)). None on LCD/touch pins: vendor IDF, vendor Arduino and xiaozhi all agree.",
  "links": {
    "page": "https://lcdwizard.com/boards/waveshare-c6-touch-lcd-183",
    "designer": "https://app.lcdwizard.com/app?board=waveshare-c6-touch-lcd-183",
    "vendorProduct": "https://www.waveshare.com/product/esp32-related/displays/lcd-spi-qspi/esp32-c6-touch-lcd-1.83.htm",
    "vendorDocs": "https://docs.waveshare.com/ESP32-C6-Touch-LCD-1.83",
    "schematic": "https://github.com/waveshareteam/ESP32-C6-Touch-LCD-1.83/blob/main/schematic/ESP32-C6-Touch-LCD-1.83_schematic.pdf"
  }
}
