{
  "id": "lcdwiki-e32r28t",
  "name": "LCDWIKI 2.8\" ESP32-32E (E32R28T)",
  "vendor": "LCDWIKI",
  "group": "All-in-one boards",
  "description": "A Cheap Yellow Display alternative: 2.8\" 320x240 ILI9341V with XPT2046 resistive touch, an RGB LED, a speaker amplifier and battery charging. The LED and audio pins are not the Sunton board's.",
  "mcu": {
    "id": "esp32",
    "name": "ESP32 (WROOM / WROVER)"
  },
  "flashMB": 4,
  "psramMB": 0,
  "usbCdc": false,
  "display": {
    "controller": "ili9342",
    "controllerName": "ILI9342 / ILI9342C",
    "interface": "spi",
    "width": 320,
    "height": 240,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": false,
    "pins": {
      "sck": 14,
      "mosi": 13,
      "miso": 12,
      "cs": 15,
      "dc": 2,
      "rst": -1
    },
    "options": {
      "freqMhz": 40,
      "spiHost": "HSPI",
      "spiMode": "0",
      "threeWire": false
    },
    "backlight": {
      "pin": 21,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "xpt2046",
    "controllerName": "XPT2046",
    "pins": {
      "sck": 25,
      "mosi": 32,
      "miso": 39,
      "cs": 33,
      "irq": 36
    },
    "swapXY": true,
    "invertX": true,
    "invertY": true,
    "options": {
      "freqKhz": 2500,
      "sharedSPI": false
    }
  },
  "buses": [],
  "ioExpanders": [],
  "peripherals": [],
  "digitalIO": [
    {
      "name": "LedRed",
      "direction": "out",
      "pin": 22,
      "activeLow": true
    },
    {
      "name": "LedGreen",
      "direction": "out",
      "pin": 16,
      "activeLow": true
    },
    {
      "name": "LedBlue",
      "direction": "out",
      "pin": 17,
      "activeLow": true
    },
    {
      "name": "BootButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    }
  ],
  "analogInputs": [
    {
      "name": "Battery",
      "pin": 34,
      "unit": "V"
    }
  ],
  "audio": {
    "output": "dac_internal",
    "pins": {
      "dac": 26,
      "pa": 4
    }
  },
  "verify": "The panel is sold as an ILI9341V but scans 320 across natively, as an ILI9342 does, so that is the controller set here - it is how every library draws it. The panel, touch and backlight are on the Sunton CYD's pins. The RGB LED is GPIO 22 (red), 16 and 17, lit low; GPIO 4 is the speaker amplifier's enable, also low - on the Sunton preset those were the red LED and nothing. The SD card and the SPI socket (CS 27) share GPIO 18/19/23, and an ESP32 has no SPI controller left for them once the panel and touch have theirs, so they are not added; adding one stops touch answering. The battery reading is scaled from typical ADC figures - check it against a meter.",
  "links": {
    "page": "https://lcdwizard.com/boards/lcdwiki-e32r28t",
    "designer": "https://app.lcdwizard.com/app?board=lcdwiki-e32r28t",
    "vendorDocs": "https://www.lcdwiki.com/2.8inch_ESP32-32E_Display",
    "schematic": "https://www.lcdwiki.com/res/E32R28T/2.8inch_ESP32-32_Display_Schematic.pdf"
  }
}
