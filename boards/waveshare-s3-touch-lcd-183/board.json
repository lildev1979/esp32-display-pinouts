    "vendorDocs": "https://docs.waveshare.com/ESP32-S3-Touch-LCD-1.83",
    "schematic": "https://github.com/waveshareteam/ESP32-S3-Touch-LCD-1.83/blob/main/schematic/ESP32-S3-Touch-LCD-1.83-schematic.pdf"
  }
