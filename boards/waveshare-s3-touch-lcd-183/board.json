{
  "id": "waveshare-s3-touch-lcd-183",
  "name": "Waveshare ESP32-S3-Touch-LCD-1.83",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "1.83\" 240x284 IPS LCD (ST7789P, SPI), CST816D touch, ES8311 audio, TF card, QMI8658, PCF85063, AXP2101.",
  "mcu": {
    "id": "esp32s3",
    "name": "ESP32-S3"
  },
  "flashMB": 16,
  "psramMB": 8,
  "usbCdc": true,
  "display": {
    "controller": "st7789",
    "controllerName": "ST7789",
    "interface": "spi",
    "width": 240,
    "height": 284,
    "colorDepth": 16,
    "rgbOrder": "rgb",
    "invert": true,
    "pins": {
      "sck": 6,
      "mosi": 7,
      "miso": -1,
      "cs": 5,
      "dc": 4,
      "rst": 38
    },
    "options": {
      "freqMhz": 24,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 40,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "cst816s",
    "controllerName": "CST816S",
    "pins": {
      "sda": 15,
      "scl": 14,
      "int": 13,
      "rst": 39
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x15",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 15 / 14)",
      "kind": "i2c",
      "pins": {
        "sda": 15,
        "scl": 14
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "IMU",
      "chip": "QMI8658",
      "kind": "Motion",
      "bus": "I2C (GPIO 15 / 14)",
      "address": "0x6B"
    },
    {
      "name": "RTC",
      "chip": "PCF85063",
      "kind": "Time",
      "bus": "I2C (GPIO 15 / 14)",
      "address": "0x51"
    },
    {
      "name": "PMICchargerrailsPWRkey",
      "chip": "AXP2101",
      "kind": "Power",
      "bus": "I2C (GPIO 15 / 14)",
      "address": "0x34"
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 0,
      "activeLow": true
    },
    {
      "name": "PWRButton",
      "direction": "in",
      "pin": 41,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": {
    "output": "es8311",
    "pins": {
      "mclk": 16,
      "bclk": 9,
      "lrclk": 45,
      "din": 8,
      "pa": 46
    }
  },
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-S3-Touch-LCD-1.83 (commit a790c727912d8f2f5f7cf56fd8cca8c892a36c76) and BSP https://components.espressif.com/components/waveshare/esp32_s3_touch_lcd_1_83 v2.0.0). Display SPI mode: BSP 0, xiaozhi 3 (both work in practice with ST7789).",
