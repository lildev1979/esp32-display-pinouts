{
  "id": "waveshare-p4-wifi6-touch-lcd-35",
  "name": "Waveshare ESP32-P4-WIFI6-Touch-LCD-3.5",
  "vendor": "Waveshare",
  "group": "All-in-one boards",
  "description": "3.5\" 320x480 IPS LCD (ST7796, SPI), FT6336 touch, ES8311 audio, TF card, AXP2101.",
  "mcu": {
    "id": "esp32p4",
    "name": "ESP32-P4"
  },
  "flashMB": 16,
  "psramMB": 32,
  "usbCdc": false,
  "display": {
    "controller": "st7796",
    "controllerName": "ST7796 / ST7796S",
    "interface": "spi",
    "width": 320,
    "height": 480,
    "colorDepth": 16,
    "rgbOrder": "bgr",
    "invert": true,
    "pins": {
      "sck": 21,
      "mosi": 20,
      "miso": -1,
      "cs": 23,
      "dc": 26,
      "rst": 27
    },
    "options": {
      "freqMhz": 80,
      "spiHost": "SPI2_HOST"
    },
    "backlight": {
      "pin": 28,
      "active": 1,
      "pwm": true,
      "freq": 5000,
      "defaultLevel": 100
    }
  },
  "touch": {
    "controller": "ft6236",
    "controllerName": "FT6236 / FT6336U",
    "pins": {
      "sda": 7,
      "scl": 8,
      "int": 50,
      "rst": 29
    },
    "swapXY": false,
    "invertX": false,
    "invertY": false,
    "options": {
      "i2cAddr": "0x38",
      "freqKhz": 400,
      "sharedI2C": true
    }
  },
  "buses": [
    {
      "name": "I2C (GPIO 7 / 8)",
      "kind": "i2c",
      "pins": {
        "sda": 7,
        "scl": 8
      }
    }
  ],
  "ioExpanders": [],
  "peripherals": [
    {
      "name": "PMICbatterycharger",
      "chip": "AXP2101",
      "kind": "Power",
      "bus": "I2C (GPIO 7 / 8)",
      "address": "0x34"
    }
  ],
  "digitalIO": [
    {
      "name": "BOOTButton",
      "direction": "in",
      "pin": 35,
      "activeLow": true
    }
  ],
  "analogInputs": [],
  "audio": null,
  "verify": "Pins from Waveshare's demo code and schematic (https://github.com/waveshareteam/ESP32-P4-WIFI6-Touch-LCD-3.5). BSP comment says touch reset is 'Shared with LCD reset' but its own define and the schematic give TP_RST = GPIO29, separate from LCD_RST GPIO27; chose 29.",
